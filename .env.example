KITE_API_KEY=
KITE_API_SECRET=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEWS_API_KEY=
REDIS_URL=redis://localhost:6379
NGROK_AUTHTOKEN=  # get from https://dashboard.ngrok.com/get-started/your-authtoken
DATABASE_URL=sqlite:///data_store/portfolio.db
USE_MOCK=false
USE_MOCK_KITE=false   # false = real Zerodha broker via KiteConnect SDK
USE_MOCK_AI=false     # false = real Claude / OpenAI calls
AI_PROVIDER=claude
PUBLIC_URL=  # set automatically by start_local.ps1

# ── Capital & Position Sizing (Week 9) ────────────────────────────────────────
TOTAL_CAPITAL=25000        # Deployable trading capital in rupees
MAX_RISK_PER_TRADE=0.02    # Fraction of capital risked per trade (0.02 = 2%)
MAX_POSITION_PCT=0.25      # Max fraction of capital in a single position (0.25 = 25%)
CASH_RESERVE_PCT=0.20      # Fraction of capital always kept as cash (0.20 = 20%)
MAX_OPEN_POSITIONS=4       # Max number of concurrent open positions
MAX_SAME_SECTOR=2          # Max open positions allowed in the same sector
WEEKLY_LOSS_LIMIT=0.05     # Pause new trades after this weekly loss (0.05 = 5%)
MIN_ORDER_VALUE=2000       # Skip orders below this rupee value
